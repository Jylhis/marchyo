---
// Base shell for the standalone (non-docs) pages — landing.
// Loads the vendored Jylhis design system (vendor/design, a copy of lib/design
// that is updated by hand): tokens, self-hosted fonts, type, motion and
// components. Applies the persisted paper/amber mode before first paint (no FOUC).
import '../../vendor/design/styles.css';
import '../styles/site.css';
import { ogImage, ogImageAlt } from '../site-meta.mjs';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Structured data: the site, and the project it documents.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Marchyo',
    alternateName: 'marchyo',
    url: 'https://marchyo.org/',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: 'Marchyo',
    description,
    url: 'https://marchyo.org/',
    codeRepository: 'https://github.com/Jylhis/marchyo',
    programmingLanguage: 'Nix',
    runtimePlatform: 'NixOS',
    license: 'https://opensource.org/licenses/MIT',
    author: { '@type': 'Person', name: 'Markus Jylhänkangas', url: 'https://jylhis.com/' },
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="marchyo" />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4efe4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b0b" />
    {/*
      Apply the stored theme before paint to avoid a flash.

      Three states, not two: 'dark' and 'light' are explicit choices and win
      outright, and only a *missing* key consults the OS preference. The stored
      value used to be '' for light, which is falsy and therefore
      indistinguishable from "never chosen" — so on a dark-mode OS, choosing
      light lasted until the next navigation and then flipped back.

      In the DOM, data-theme='dark' means dark and no attribute means light;
      that contract is unchanged.
    */}
    <script is:inline>
      // The design tokens switch on [data-mode]; this page toggles
      // [data-theme]. Mirror one onto the other.
      (function () {
        var d = document.documentElement;
        function sync() {
          d.dataset.mode = d.dataset.theme === 'dark' ? 'dark' : 'light';
        }
        new MutationObserver(sync).observe(d, { attributeFilter: ['data-theme'] });
        sync();
      })();
    </script>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('marchyo-theme');
          if (stored === 'dark') {
            document.documentElement.dataset.theme = 'dark';
          } else if (stored !== 'light') {
            if (
              window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: dark)').matches
            ) {
              document.documentElement.dataset.theme = 'dark';
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    {/*
      The theme toggle, once, for every page that uses this layout. It used to
      be duplicated per page, which let copies drift from the pre-paint
      script above.
    */}
    <script is:inline>
      (function () {
        function isDark() {
          return document.documentElement.dataset.theme === 'dark';
        }
        function apply(theme) {
          if (theme === 'dark') document.documentElement.dataset.theme = 'dark';
          else delete document.documentElement.dataset.theme;
          var buttons = document.querySelectorAll('[data-theme-toggle]');
          for (var i = 0; i < buttons.length; i++) {
            buttons[i].textContent = theme === 'dark' ? '\u2600' : '\u263e';
          }
        }
        apply(isDark() ? 'dark' : 'light');
        var buttons = document.querySelectorAll('[data-theme-toggle]');
        for (var i = 0; i < buttons.length; i++) {
          buttons[i].addEventListener('click', function () {
            // Store 'light' explicitly, never '' — see the head script.
            var next = isDark() ? 'light' : 'dark';
            try {
              localStorage.setItem('marchyo-theme', next);
            } catch (e) {}
            apply(next);
          });
        }
      })();
    </script>
  </body>
</html>
