---
// Base shell for the standalone (non-docs) pages — landing + search.
// Loads the self-hosted variable fonts and the vendored Jylhis design system,
// and applies the persisted paper/roast theme before first paint (no FOUC).
// v2 three-role stack: Zilla Slab display (600/700), Hanken Grotesk body
// (variable), IBM Plex Mono chrome (400/500 + italic).
import '@fontsource/zilla-slab/600.css';
import '@fontsource/zilla-slab/700.css';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/hanken-grotesk/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/400-italic.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/jylhis.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#faf7f2" />
    {/*
      Apply the stored theme before paint to avoid a flash.

      Three states, not two: 'dark' and 'light' are explicit choices and win
      outright, and only a *missing* key consults the OS preference. The stored
      value used to be '' for light, which is falsy and therefore
      indistinguishable from "never chosen" — so on a dark-mode OS, choosing
      light lasted until the next navigation and then flipped back.

      In the DOM, data-theme='dark' means dark and no attribute means light;
      that contract is unchanged.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('marchyo-theme');
          if (stored === 'dark') {
            document.documentElement.dataset.theme = 'dark';
          } else if (stored !== 'light') {
            if (
              window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: dark)').matches
            ) {
              document.documentElement.dataset.theme = 'dark';
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    {/*
      The theme toggle, once, for every page that uses this layout. It used to
      be duplicated verbatim in index.astro and search.astro (both comments
      even said "shared behaviour"), which is how the two drifted from the
      pre-paint script above.
    */}
    <script is:inline>
      (function () {
        function isDark() {
          return document.documentElement.dataset.theme === 'dark';
        }
        function apply(theme) {
          if (theme === 'dark') document.documentElement.dataset.theme = 'dark';
          else delete document.documentElement.dataset.theme;
          var buttons = document.querySelectorAll('[data-theme-toggle]');
          for (var i = 0; i < buttons.length; i++) {
            buttons[i].textContent = theme === 'dark' ? '\u2600' : '\u263e';
          }
        }
        apply(isDark() ? 'dark' : 'light');
        var buttons = document.querySelectorAll('[data-theme-toggle]');
        for (var i = 0; i < buttons.length; i++) {
          buttons[i].addEventListener('click', function () {
            // Store 'light' explicitly, never '' — see the head script.
            var next = isDark() ? 'light' : 'dark';
            try {
              localStorage.setItem('marchyo-theme', next);
            } catch (e) {}
            apply(next);
          });
        }
      })();
    </script>
  </body>
</html>
