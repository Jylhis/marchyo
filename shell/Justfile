# List all available recipes
default:
    @just --list

# Dev loop: run the shell straight from the tree (hot-reloads QML on save).
# Stops the store-backed user service first so the two instances don't fight
# over the bar slot and org.freedesktop.Notifications. Dev defaults apply:
# dark variant, fontScale 1.0, tools from PATH (see README.md). The env vars
# mirror the marchyo-shell wrapper (packages/marchyo-shell/package.nix) so
# the dev instance behaves like the store shell: TZDIR lets Qt resolve the
# system time zone from NixOS's /etc/zoneinfo, and the gtk3 platform theme
# makes themed icons resolve against marchyo's Adwaita GTK settings.
dev:
    systemctl --user stop marchyo-shell
    TZDIR=/etc/zoneinfo QT_QPA_PLATFORMTHEME=gtk3 quickshell -p .

# Hand the bar back to the store-backed user service after a dev session
resume:
    systemctl --user start marchyo-shell

# Type-check the QML tree offscreen: run the harness (harness.qml) under
# QT_QPA_PLATFORM=offscreen and fail on any QML warning/error pointing at a
# file in this tree. Service-level noise from Quickshell itself (missing
# Hyprland socket, absent external tools offscreen) is tolerated — the harness
# exits itself after the settle period; the timeout is a safety net.
check:
    #!/usr/bin/env bash
    set -euo pipefail
    log="$(mktemp)"
    trap 'rm -f "$log"' EXIT
    if ! TZDIR=/etc/zoneinfo QT_QPA_PLATFORM=offscreen timeout 30 quickshell -p ./harness.qml 2>&1 | tee "$log"; then
        echo "check: quickshell harness failed or timed out" >&2
        exit 1
    fi
    if ! grep -q "Configuration Loaded" "$log"; then
        echo "check: harness never reached 'Configuration Loaded'" >&2
        exit 1
    fi
    if grep -E "(WARN|ERROR).*(qml\[|/shell/)" "$log" | grep -v "offscreen"; then
        echo "check: QML warnings/errors from the shell tree" >&2
        exit 1
    fi
    echo "check: shell tree parsed and bound cleanly"
