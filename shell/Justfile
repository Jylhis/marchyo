# List all available recipes
default:
    @just --list

# Dev loop: run the tree's shell in the isolated sandbox (nested Hyprland in a
# window, live reload on save) and follow its log. The live session and the
# store-backed marchyo-shell service are not touched. See README.md "Sandbox".
dev:
    dev/sandbox up --window
    dev/sandbox log -f

# Old dev loop: stop the store-backed user service and run the tree's shell in
# the live session. Dev defaults apply (dark variant, fontScale 1.0, tools from
# PATH). The env vars mirror the marchyo-shell wrapper
# (packages/marchyo-shell/package.nix): TZDIR lets Qt resolve the system time
# zone and the gtk3 platform theme resolves themed icons against marchyo's GTK
# settings.
dev-live:
    systemctl --user stop marchyo-shell
    TZDIR=/etc/zoneinfo QT_QPA_PLATFORMTHEME=gtk3 quickshell -p .

# Hand the bar back to the store-backed user service after a dev-live session
resume:
    systemctl --user start marchyo-shell

# Run a sandbox subcommand: up, down, status, env, ipc, log, hyprctl
sandbox *args:
    dev/sandbox {{args}}

# Screenshot one surface in the sandbox: shot launcher --state query=fire
shot *args:
    dev/shot {{args}}

# Stop the sandbox and remove its runtime dir
sandbox-down:
    dev/sandbox down

# Vet and test the sandbox MCP server (dev/mcp)
mcp-test:
    cd dev/mcp && go vet ./... && go test ./...

# Type-check the QML tree offscreen: run the harness (harness.qml) under
# QT_QPA_PLATFORM=offscreen and fail on any QML warning/error pointing at a
# file in this tree. Service-level noise from Quickshell itself (missing
# Hyprland socket, absent external tools offscreen) is tolerated — the harness
# exits itself after the settle period; the timeout is a safety net.
check:
    #!/usr/bin/env bash
    set -euo pipefail
    log="$(mktemp)"
    plugin_dir="$(mktemp -d)"
    trap 'rm -rf "$log" "$plugin_dir"' EXIT
    # The vendored omarchy speedtest panel, rewritten as the build does.
    cp compat/plugins/speedtest/Panel.qml "$plugin_dir/Panel.qml"
    sed -i -E -f compat/rewrite.sed "$plugin_dir/Panel.qml"
    # A live session would answer hyprctl probes (e.g. stranded-lock recovery).
    if ! env -u HYPRLAND_INSTANCE_SIGNATURE TZDIR=/etc/zoneinfo OMARCHY_PATH="$PWD/compat/omarchy" HARNESS_PLUGIN_DIR="$plugin_dir" QT_QPA_PLATFORM=offscreen timeout 30 quickshell -p ./harness.qml 2>&1 | tee "$log"; then
        echo "check: quickshell harness failed or timed out" >&2
        exit 1
    fi
    if ! grep -q "Configuration Loaded" "$log"; then
        echo "check: harness never reached 'Configuration Loaded'" >&2
        exit 1
    fi
    if grep -q "ASSERT-FAIL" "$log"; then
        echo "check: harness render assertions failed" >&2
        grep "ASSERT-FAIL" "$log" >&2
        exit 1
    fi
    if ! grep -q "ASSERT-DONE" "$log"; then
        echo "check: harness assertions never ran" >&2
        exit 1
    fi
    if grep -E "(WARN|ERROR).*(qml\[|/shell/)" "$log" | grep -v "offscreen"; then
        echo "check: QML warnings/errors from the shell tree" >&2
        exit 1
    fi
    echo "check: shell tree parsed and bound cleanly"
