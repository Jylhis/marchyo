# Marchyo Plymouth Theme Script
#
# Boot animation: the "❯" caret wipes one word onto the screen and off again,
# alternating between "marchyo" and "jylhis". Sweeping right reveals the
# word, sweeping left hides it; the word swaps while the screen is blank.
# Plymouth has no clipping, so the reveal is a bg-colored cover sprite whose
# left edge tracks the caret — on a flat background it's indistinguishable
# from a mask.
#
# Juice: ease-in-out-back sweeps (the caret overshoots its mark and settles),
# a prompt-style blink while resting, and a pool of copper sparkle particles
# trailing the caret tip with a small burst when a word lands. All of it runs
# in the refresh callback at ~50 fps — as smooth as Plymouth allows.
#
# Assets (built in package.nix):
#   marchyo.png   — "marchyo" wordmark, brand color
#   jylhis.png    — "jylhis" wordmark, brand color, same cap height
#   caret.png     — chevron glyph (caret.svg), accent color
#   sparkle1-3.png — four-point stars (sparkle.svg), syntax-palette tints
#   cover.png     — solid bg-color rectangle, widest-word-sized
#
# Background = Jylhis Roast bg token; the @bg*@ placeholders are substituted
# from tokens.json at build time (see package.nix).
Window.SetBackgroundTopColor(@bgR@, @bgG@, @bgB@);
Window.SetBackgroundBottomColor(@bgR@, @bgG@, @bgB@);

# Words + caret

word.images[0] = Image("marchyo.png");
word.images[1] = Image("jylhis.png");
word.sprites[0] = Sprite(word.images[0]);
word.sprites[1] = Sprite(word.images[1]);

# Both words share a centered baseline; only the active one is visible.
word.y = Window.GetHeight() / 2 - word.images[0].GetHeight() / 2;
word.h = word.images[0].GetHeight();
for (i = 0; i < 2; i++)
  {
    word.x[i] = Window.GetWidth() / 2 - word.images[i].GetWidth() / 2;
    word.sprites[i].SetPosition(word.x[i], word.y, 1);
    word.sprites[i].SetOpacity(0);
  }

global.active = 0;
word.sprites[0].SetOpacity(1);

caret.image = Image("caret.png");
# Left-facing twin, rotated once at init (180 deg) — swapping images per
# direction costs nothing per frame, unlike rotating live.
caret.image_left = caret.image.Rotate(Math.Pi);
caret.y = word.y + word.h / 2 - caret.image.GetHeight() / 2;
caret.sprite = Sprite(caret.image);
global.caret_dir = 1;   # 1 = facing right, -1 = facing left

# Cover sits above the words, below the caret. Its left edge follows the
# caret; anything past the word's right edge lands on plain bg and is
# invisible. Sized to the widest word, slightly taller for anti-aliasing.
cover.image = Image("cover.png");
cover.sprite = Sprite(cover.image);

# Sparkles

# Particle pool. Three syntax-palette tints (sparkle1-3.png, built in
# package.nix) x three pre-scaled sizes = nine variants, so nothing is
# retinted or rescaled per frame.
for (c = 0; c < 3; c++)
  {
    if (c == 0) base = Image("sparkle1.png");
    if (c == 1) base = Image("sparkle2.png");
    if (c == 2) base = Image("sparkle3.png");
    sparkle.variants[c * 3 + 0] = base;
    sparkle.variants[c * 3 + 1] = base.Scale(base.GetWidth() * 0.66, base.GetHeight() * 0.66);
    sparkle.variants[c * 3 + 2] = base.Scale(base.GetWidth() * 0.4,  base.GetHeight() * 0.4);
  }

global.max_sparkles = 20;
for (i = 0; i < global.max_sparkles; i++)
  {
    sparkle.sprites[i] = Sprite();
    sparkle.life[i] = 0.0;
    sparkle.x[i] = 0.0;
    sparkle.y[i] = 0.0;
    sparkle.vx[i] = 0.0;
    sparkle.vy[i] = 0.0;
    sparkle.decay[i] = 0.03;
  }

fun spawn_sparkle(x, y, vx, vy)
  {
    for (i = 0; i < global.max_sparkles; i++)
      {
        if (sparkle.life[i] <= 0.0)
          {
            sparkle.life[i] = 1.0;
            sparkle.decay[i] = 0.02 + Math.Random() * 0.02;
            sparkle.x[i] = x;
            sparkle.y[i] = y;
            sparkle.vx[i] = vx + (Math.Random() - 0.5) * 2.0;
            sparkle.vy[i] = vy + (Math.Random() - 0.5) * 2.0 - 0.7;
            variant = Math.Int(Math.Random() * 9);
            sparkle.sprites[i].SetImage(sparkle.variants[variant]);
            return;
          }
      }
  }

fun update_sparkles()
  {
    for (i = 0; i < global.max_sparkles; i++)
      {
        if (sparkle.life[i] <= 0.0)
          continue;
        sparkle.life[i] -= sparkle.decay[i];
        if (sparkle.life[i] <= 0.0)
          {
            sparkle.sprites[i].SetOpacity(0);
            continue;
          }
        sparkle.x[i] += sparkle.vx[i];
        sparkle.y[i] += sparkle.vy[i];
        sparkle.vy[i] += 0.06;           # a whisper of gravity
        sparkle.vx[i] *= 0.96;
        sparkle.vy[i] *= 0.96;
        sparkle.sprites[i].SetPosition(sparkle.x[i], sparkle.y[i], 4);
        sparkle.sprites[i].SetOpacity(sparkle.life[i]);
      }
  }

# Sweep

# Timing in seconds (refresh callback ticks at ~50 fps -> 0.02 s/frame):
# sweep right (reveal) -> hold -> sweep left (hide) -> blank gap + word swap.
global.sweep_duration = 1.2;
global.hold_duration  = 1.3;
global.gap_duration   = 0.7;
global.cycle = 2 * global.sweep_duration + global.hold_duration + global.gap_duration;
global.cycle_t = 0.0;
global.clock = 0.0;
global.prev_x = 0.0;
global.burst_done = 0;

# ease-in-out-back — sine-smooth with a small overshoot at each end. The
# overshoot is the juice: the caret lands past its mark and settles back.
# k tunes the overshoot strength.
fun ease(s)
  {
    k = 0.9;
    c1 = 1.70158 * k;
    c2 = c1 * 1.525;
    if (s < 0.5)
      {
        t = 2 * s;
        return (t * t * ((c2 + 1) * t - c2)) / 2;
      }
    t = 2 * s - 2;
    return (t * t * ((c2 + 1) * t + c2) + 2) / 2;
  }

# Place caret + cover for a reveal fraction u (0 hidden, 1 revealed; the
# easing may push u slightly outside that range — harmless, the cover just
# runs onto plain background). Returns the caret x for the sparkle emitter.
fun set_reveal(u)
  {
    i = global.active;
    x0 = word.x[i] - caret.image.GetWidth() * 0.6;
    x1 = word.x[i] + word.images[i].GetWidth() + caret.image.GetWidth() * 0.15;
    x = x0 + u * (x1 - x0);
    caret.sprite.SetPosition(x, caret.y, 3);
    cover.sprite.SetPosition(x + caret.image.GetWidth() * 0.12,
                             word.y - 4, 2);
    return x;
  }

set_reveal(0.0);

fun swap_word()
  {
    word.sprites[global.active].SetOpacity(0);
    global.active = 1 - global.active;
    word.sprites[global.active].SetOpacity(1);
  }

fun animate_sweep()
  {
    global.clock += 0.02;
    global.cycle_t += 0.02;
    if (global.cycle_t >= global.cycle)
      {
        global.cycle_t -= global.cycle;
        swap_word();               # swap while the screen is blank
        global.burst_done = 0;
      }
    t = global.cycle_t;

    sweep = global.sweep_duration;
    hold  = global.hold_duration;

    moving = 0;
    dir = 1;                                # facing: 1 right, -1 left
    if (t < sweep)                          # sweeping right - revealing
      {
        u = ease(t / sweep);
        moving = 1;
      }
    else if (t < sweep + hold)              # fully shown
      u = 1.0;
    else if (t < sweep + hold + sweep)      # sweeping left - hiding
      {
        u = 1.0 - ease((t - sweep - hold) / sweep);
        moving = 1;
        dir = -1;
      }
    else                                    # blank gap before next word
      u = 0.0;

    # Rotate the caret to face the direction of travel (image swap, free).
    if (dir != global.caret_dir)
      {
        global.caret_dir = dir;
        if (dir == 1)
          caret.sprite.SetImage(caret.image);
        else
          caret.sprite.SetImage(caret.image_left);
      }

    x = set_reveal(u);

    # Prompt blink while resting; solid while moving. 1.1 s, steps(1).
    if (moving == 1)
      caret.sprite.SetOpacity(1);
    else
      {
        blink_t = global.clock;
        while (blink_t >= 1.1)
          blink_t -= 1.1;
        if (blink_t < 0.6)
          caret.sprite.SetOpacity(1);
        else
          caret.sprite.SetOpacity(0);
      }

    # Sparkle trail from the caret tip while sweeping fast.
    v = x - global.prev_x;
    global.prev_x = x;
    speed = Math.Abs(v);
    if (global.caret_dir == 1)
      tip_x = x + caret.image.GetWidth() * 0.7;
    else
      tip_x = x + caret.image.GetWidth() * 0.3;
    tip_y = word.y + word.h * (0.25 + Math.Random() * 0.5);
    if (moving == 1 && speed > 2.0 && Math.Random() < 0.8)
      spawn_sparkle(tip_x, tip_y, 0 - v * 0.12, 0);

    # Burst when a word lands fully revealed.
    if (moving == 0 && u >= 1.0 && global.burst_done == 0)
      {
        global.burst_done = 1;
        for (b = 0; b < 8; b++)
          spawn_sparkle(tip_x, word.y + word.h * 0.5,
                        1.5 + Math.Random() * 2.0, 0);
      }

    update_sparkles();
  }

# Use these to adjust the progress bar timing
global.fake_progress_limit = 0.7;  # Target percentage for fake progress (0.0 to 1.0)
global.fake_progress_duration = 15.0;  # Duration in seconds to reach limit
global.fake_progress_duration_inv = 1.0 / global.fake_progress_duration;  # Inverse for multiplication optimization

# Progress bar animation variables
global.fake_progress = 0.0;
global.real_progress = 0.0;
global.fake_progress_active = 0; # 0 / 1 boolean
global.animation_frame = 0;
global.fake_progress_start_time = 0;  # Track when fake progress started
global.password_shown = 0;  # Track if password dialog has been shown
global.max_progress = 0.0;  # Track the maximum progress reached to prevent backwards movement
global.last_width = 1;      # Track the last width to avoid unnecessary scaling

fun refresh_callback ()
  {
    global.animation_frame++;

    # Hold the active word fully revealed while the password dialog is up —
    # a wiping wordmark behind a passphrase prompt is distracting.
    if (global.password_shown == 1 && global.fake_progress_active == 0)
      set_reveal(1.0);
    else
      animate_sweep();

    # Animate fake progress to limit over time with easing
    if (global.fake_progress_active == 1)
      {
        # Calculate elapsed time since start
        elapsed_time = global.animation_frame * 0.02;  # Convert frames to seconds (50 FPS)

        # Calculate linear progress ratio (0 to 1) based on time
        time_ratio = elapsed_time * global.fake_progress_duration_inv;
        if (time_ratio > 1.0)
          time_ratio = 1.0;

        # Apply easing curve: ease-out quadratic
        # Formula: 1 - (1 - x)^2
        eased_ratio = 1 - ((1 - time_ratio) * (1 - time_ratio));

        # Calculate fake progress based on eased ratio
        global.fake_progress = eased_ratio * global.fake_progress_limit;

        # Update progress bar with fake progress
        update_progress_bar(global.fake_progress);
      }
  }


Plymouth.SetRefreshFunction (refresh_callback);

# Helper Functions

fun update_progress_bar(progress)
  {
    # Only update if progress is moving forward
    if (progress > global.max_progress)
      {
        global.max_progress = progress;
        width = Math.Int(progress_bar.original_image.GetWidth() * progress);
        if (width < 1) width = 1;  # Ensure minimum width of 1 pixel

        # Optimization: Only scale if width changed
        if (width != global.last_width)
          {
            global.last_width = width;
            progress_bar.image = progress_bar.original_image.Scale(width, progress_bar.original_image.GetHeight());
            progress_bar.sprite.SetImage(progress_bar.image);
          }
      }
  }

fun show_progress_bar()
  {
    progress_box.sprite.SetOpacity(1);
    progress_bar.sprite.SetOpacity(1);
  }

fun hide_progress_bar()
  {
    progress_box.sprite.SetOpacity(0);
    progress_bar.sprite.SetOpacity(0);
  }

fun show_password_dialog()
  {
    lock.sprite.SetOpacity(1);
    entry.sprite.SetOpacity(1);
  }

fun hide_password_dialog()
  {
    lock.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(0);
    for (index = 0; bullet.sprites[index]; index++)
      bullet.sprites[index].SetOpacity(0);
  }

fun start_fake_progress()
  {
    # Don't reset if we already have progress
    if (global.max_progress == 0.0)
      {
        global.fake_progress = 0.0;
        global.real_progress = 0.0;
        update_progress_bar(0.0);
      }
    global.fake_progress_active = 1;
    global.animation_frame = 0;
  }

fun stop_fake_progress()
  {
    global.fake_progress_active = 0;
  }

# Dialogue

lock.image = Image("lock.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth()/2 - entry.image.GetWidth() / 2;
entry.y = word.y + word.h + 40;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

# Scale lock to be slightly shorter than entry field height
# Original lock is 84x96, entry height determines scale
lock_height = entry.image.GetHeight() * 0.8;
lock_scale = lock_height / 96;
lock_width = 84 * lock_scale;

scaled_lock = lock.image.Scale(lock_width, lock_height);
lock.sprite = Sprite(scaled_lock);
lock.x = entry.x - lock_width - 15;
lock.y = entry.y + entry.image.GetHeight()/2 - lock_height/2;
lock.sprite.SetPosition(lock.x, lock.y, 10001);
lock.sprite.SetOpacity(0);

# Bullet array
bullet.sprites = [];

fun display_normal_callback ()
  {
    hide_password_dialog();

    # Get current mode
    mode = Plymouth.GetMode();

    # Only show progress bar for boot and resume modes
    if ((mode == "boot" || mode == "resume") && global.password_shown == 1)
      {
        show_progress_bar();
        start_fake_progress();
      }
  }

fun display_password_callback (prompt, bullets)
  {
    global.password_shown = 1;  # Mark that password dialog has been shown

    # Reset progress when password dialog appears
    stop_fake_progress();
    hide_progress_bar();
    global.max_progress = 0.0;
    global.fake_progress = 0.0;
    global.real_progress = 0.0;
    show_password_dialog();

    # Clear all bullets first
    for (index = 0; bullet.sprites[index]; index++)
      bullet.sprites[index].SetOpacity(0);

    # Create and show bullets for current password (max 21)
    max_bullets = 21;
    bullets_to_show = bullets;
    if (bullets_to_show > max_bullets)
      bullets_to_show = max_bullets;

    for (index = 0; index < bullets_to_show; index++)
      {
        if (!bullet.sprites[index])
          {
            # Scale bullet image to 7x7 pixels
            scaled_bullet = bullet.image.Scale(7, 7);
            bullet.sprites[index] = Sprite(scaled_bullet);
            bullet.x = entry.x + 20 + index * (7 + 5);
            bullet.y = entry.y + entry.image.GetHeight() / 2 - 3.5;
            bullet.sprites[index].SetPosition(bullet.x, bullet.y, 10002);
          }
        bullet.sprites[index].SetOpacity(1);
      }
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Progress Bar

progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);

progress_box.x = Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = entry.y + entry.image.GetHeight() / 2 - progress_box.image.GetHeight() / 2;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);
progress_box.sprite.SetOpacity(0);

progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();
progress_bar.image = progress_bar.original_image.Scale(1, progress_bar.original_image.GetHeight());

progress_bar.x = Window.GetWidth() / 2 - progress_bar.original_image.GetWidth() / 2;
progress_bar.y = progress_box.y + (progress_box.image.GetHeight() - progress_bar.original_image.GetHeight()) / 2;
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 1);
progress_bar.sprite.SetOpacity(0);

fun progress_callback (duration, progress)
  {
    global.real_progress = progress;

    # If real progress is above limit, stop fake progress and use real progress
    if (progress > global.fake_progress_limit)
      {
        stop_fake_progress();
        update_progress_bar(progress);
      }
  }

Plymouth.SetBootProgressFunction(progress_callback);

# Quit

fun quit_callback ()
{
  # Land on "marchyo" fully revealed, caret parked past it.
  if (global.active != 0)
    swap_word();
  set_reveal(1.0);
}

Plymouth.SetQuitFunction(quit_callback);

# Message

message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);

# Boot messages in the text token color (substituted at build time like the
# background) so they stay readable on both the Roast and Paper variants —
# hardcoded white would vanish on the light background.
fun display_message_callback (text)
{
  my_image = Image.Text(text, @fgR@, @fgG@, @fgB@);
  message_sprite.SetImage(my_image);
}

fun hide_message_callback (text)
{
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction (display_message_callback);
Plymouth.SetHideMessageFunction (hide_message_callback);
