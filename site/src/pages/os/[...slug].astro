---
import App from '../../os/App.jsx';
import OsLayout from '../../layouts/OsLayout.astro';

export function getStaticPaths() {
  return [undefined, 'fleet', 'profiles', 'repos', 'settings'].map(
    (slug) => ({ params: { slug } }),
  );
}
---

<OsLayout>
  <App client:only="react" />
</OsLayout>
