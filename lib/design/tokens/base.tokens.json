{
  "$description": "Theme-independent core framework: structure, type, spacing, motion, density. One theme (Jylhis) with a light and a dark mode — paper and black, one international-orange accent.",
  "$extensions": {
    "com.jylhis": {
      "meta": {
        "name": "Jylhis Design System",
        "description": "Theme-independent core framework: structure, type, spacing, motion, density. One theme (Jylhis) with a light and a dark mode — paper and black, one international-orange accent."
      },
      "theme": {
        "name": "Jylhis",
        "slug": "jylhis",
        "blurb": "one theme, two modes: warm paper with one SBB red signal by day, amber on black by night; ink links, hairline panels, bevelled controls",
        "modes": {
          "light": "Paper — ink on warm paper",
          "dark": "Amber — amber on terminal black"
        }
      },
      "groups": {
        "grounds": {
          "label": "Grounds",
          "blurb": "page backgrounds and card surfaces, four tonal steps",
          "members": [
            "bg",
            "bg-subtle",
            "surface",
            "surface-raised",
            "scrim"
          ]
        },
        "ink": {
          "label": "Ink",
          "blurb": "what is drawn on the sheet: text in every weight, and label, the frame hue for field names, table heads and keys",
          "members": [
            "text-heading",
            "text",
            "text-muted",
            "text-faint",
            "label"
          ]
        },
        "primary": {
          "label": "Primary",
          "blurb": "the one signal colour (SBB red by day, amber by night) and its bevel edges; one primary per page and the mark chevron, nothing else",
          "members": [
            "primary",
            "on-primary",
            "primary-hi",
            "primary-lo",
            "primary-edge"
          ]
        },
        "accent": {
          "label": "Links and focus",
          "blurb": "ink links, the focus ring, selection and the cursor; accent, accent-hover and accent-subtle are deprecated aliases kept for 4.x readers",
          "members": [
            "link",
            "link-underline-hover",
            "focus-ring",
            "accent",
            "accent-hover",
            "accent-subtle",
            "selection-bg",
            "cursor"
          ]
        },
        "consequence": {
          "label": "Consequence",
          "blurb": "the irreversible-action role: ink by day so it never reads as the primary, red by night",
          "members": [
            "destructive"
          ]
        },
        "line": {
          "label": "Line",
          "blurb": "the hairline, the strong border for field edges and table heads, and the 2px ink rule",
          "members": [
            "border",
            "border-strong",
            "rule"
          ]
        },
        "bevel": {
          "label": "Bevel",
          "blurb": "the two-tone bevel and ink bottom line of pressable controls, and only of those",
          "members": [
            "bevel-face",
            "bevel-hi",
            "bevel-lo",
            "bevel-edge"
          ]
        },
        "modus": {
          "label": "Modus",
          "blurb": "syntax role taxonomy — keyword, string, type, comment; a theme maps these to its own syntax voice, never repurposed for UI",
          "members": [
            "syn-keyword",
            "syn-string",
            "syn-number",
            "syn-function",
            "syn-builtin",
            "syn-type",
            "syn-variable",
            "syn-comment",
            "syn-docstring"
          ]
        },
        "signal": {
          "label": "Signal",
          "blurb": "status colors — error, warning, ok, info; always paired with a glyph + word (themes may not drop them to grayscale)",
          "members": [
            "status-err",
            "status-warn",
            "status-ok",
            "status-info"
          ]
        },
        "chart": {
          "label": "Chart",
          "blurb": "the W.E.B. Du Bois palette, inside charts only; every bar is labelled directly",
          "members": [
            "chart-1",
            "chart-2",
            "chart-3",
            "chart-4",
            "chart-5",
            "chart-ink"
          ]
        },
        "spectrum": {
          "label": "Spectrum",
          "blurb": "the 16-slot ANSI terminal palette; slot 11 is the accent in Amber only, a true dark yellow in Paper",
          "members": [
            "black",
            "red",
            "green",
            "yellow",
            "blue",
            "magenta",
            "cyan",
            "white",
            "bright-black",
            "bright-red",
            "bright-green",
            "bright-yellow",
            "bright-blue",
            "bright-magenta",
            "bright-cyan",
            "bright-white"
          ]
        }
      },
      "typography": {
        "roles": {
          "display": {
            "weight": 500,
            "lineHeight": 1.05,
            "letterSpacing": "0"
          },
          "body": {
            "sizeBase": "1.125rem",
            "lineHeight": 1.6
          },
          "mono": {},
          "numeric": {
            "notes": "figures, amounts and readouts — IBM Plex Mono with tabular-nums; declared as --font-numeric"
          },
          "heading": {
            "inherits": "display",
            "lineHeight": 1.15,
            "letterSpacing": "0"
          },
          "label": {
            "inherits": "mono",
            "weight": 500,
            "letterSpacing": "0",
            "transform": "none"
          }
        },
        "tuiFallback": "\"IBM Plex Mono\", \"JetBrains Mono\", Iosevka, \"Fira Mono\", \"DejaVu Sans Mono\", monospace",
        "scaling": {
          "rootFontSize": "user-agent",
          "minRelativeEm": 0.85,
          "fluid": "clamp(<rem-min>, <rem-base> + <vw>, <rem-max>)",
          "targets": {
            "resizeText": "200%",
            "reflowWidth": "320px",
            "reflowZoom": "400%"
          },
          "textSpacing": {
            "lineHeight": 1.5,
            "letterSpacing": "0.12em",
            "wordSpacing": "0.16em",
            "paragraphSpacing": "2em"
          },
          "notes": "Every step is a rem multiple of the user agent's root font size — the system never sets `html { font-size }`. readableFloor is the smallest step for text a user must read; absoluteFloor is the hard floor for glanceable chrome. Specified in design(7)."
        },
        "notes": "Three families: Jost for display (never bolder than 500), Fira Sans for text, IBM Plex Mono for labels, data, code and figures. Labels are lowercase in content, never upper-cased by CSS.",
        "scaleAliases": [
          "display",
          "h1",
          "h2",
          "lead",
          "h3",
          "body",
          "ui",
          "small",
          "data",
          "label"
        ]
      },
      "sound": {
        "tap": {
          "theme": "bell",
          "meaning": "generic acknowledgement"
        },
        "error": {
          "theme": "dialog-error",
          "meaning": "something went wrong"
        },
        "complete": {
          "theme": "complete",
          "meaning": "long task finished"
        }
      }
    }
  },
